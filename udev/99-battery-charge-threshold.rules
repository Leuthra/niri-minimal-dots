# Maintain 80% maximum charge limit for battery longevity (only apply if supported by kernel)
SUBSYSTEM=="power_supply", ATTR{type}=="Battery", TEST=="charge_control_end_threshold", ATTR{charge_control_end_threshold}="80"
SUBSYSTEM=="power_supply", ATTR{type}=="Battery", TEST=="charge_stop_threshold", ATTR{charge_stop_threshold}="80"

