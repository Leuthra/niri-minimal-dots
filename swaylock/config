daemonize
ignore-empty-password
show-failed-attempts
indicator-caps-lock
scaling=fill

# Indicator dimensions
indicator-radius=115
indicator-thickness=12

# Font
font=JetBrainsMono Nerd Font

# Fallback background color (Catppuccin Mocha Base)
color=1e1e2e

# Inside circle colors
inside-color=1e1e2e80
inside-clear-color=a6e3a180
inside-ver-color=89b4fa80
inside-wrong-color=f38ba880

# Outer ring colors
ring-color=b4befe
ring-clear-color=a6e3a1
ring-ver-color=89b4fa
ring-wrong-color=f38ba8

# Keypress and backspace highlights
key-hl-color=cba6f7
bs-hl-color=f38ba8
line-color=00000000
separator-color=00000000

# Text colors
text-color=cdd6f4
text-clear-color=1e1e2e
text-ver-color=1e1e2e
text-wrong-color=1e1e2e
