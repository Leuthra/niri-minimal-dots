#!/bin/bash
# Smart lockscreen for Niri Wayland session
# Priority:
# 1. hyprlock (Modern UI: live blur + digital clock + date + user greeting + styled input field)
# 2. swaylock-effects (live blur + clock + date)
# 3. swaylock (current wallpaper + Catppuccin Mocha ring theme)

if command -v hyprlock >/dev/null 2>&1; then
    CONFIG="$HOME/.config/hypr/hyprlock.conf"
    if [ -f "$CONFIG" ]; then
        exec hyprlock --config "$CONFIG"
    else
        exec hyprlock
    fi
fi

# Detect wallpaper for swaylock
WALLPAPER=""
if [ -f "$HOME/.config/niri/current-wallpaper" ]; then
    SAVED_WALL=$(cat "$HOME/.config/niri/current-wallpaper" 2>/dev/null)
    [ -f "$SAVED_WALL" ] && WALLPAPER="$SAVED_WALL"
fi

if [ -z "$WALLPAPER" ]; then
    for f in "$HOME/.config/wallpapers"/* "$HOME/Pictures/wallpapers"/*; do
        if [ -f "$f" ]; then
            WALLPAPER="$f"
            break
        fi
    done
fi

# Check if swaylock supports swaylock-effects features
if swaylock --help 2>&1 | grep -q "effect-blur"; then
    exec swaylock -f \
        --screenshots \
        --clock \
        --indicator \
        --indicator-radius 120 \
        --indicator-thickness 14 \
        --effect-blur 8x6 \
        --datestr "%A, %d %B %Y" \
        --timestr "%H:%M" \
        --fade-in 0.2
else
    if [ -n "$WALLPAPER" ]; then
        exec swaylock -f -i "$WALLPAPER" -s fill
    else
        exec swaylock -f
    fi
fi
