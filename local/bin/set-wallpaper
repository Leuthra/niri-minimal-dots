#!/bin/bash
# fuzzel-wallpaper - Interactive & Random wallpaper switcher
# Supports: swaybg, swww, hyprpaper

# Search candidate directories in order of preference
CANDIDATES=(
    "${FUZZEL_WALLPAPER_DIR:-}"
    "$HOME/.config/wallpapers"
    "$HOME/niri-minimal-dots/wallpapers"
    "$HOME/.dotfiles/wallpapers"
    "$HOME/Pictures/wallpapers"
)

WALLDIR=""
for d in "${CANDIDATES[@]}"; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    # Verify directory contains images (using -L to follow symlinks)
    if find -L "$d/" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) 2>/dev/null | grep -q .; then
        WALLDIR="$d"
        break
    fi
done

[ -z "$WALLDIR" ] && WALLDIR="$HOME/.config/wallpapers"
STATE_FILE="$HOME/.config/niri/current-wallpaper"

mkdir -p "$(dirname "$STATE_FILE")"

detect_setter() {
    for cmd in swww swaybg hyprpaper; do
        command -v "$cmd" >/dev/null 2>&1 && echo "$cmd" && return
    done
    echo "none"
}

set_wallpaper() {
    local wall="$1"
    local setter="$2"

    [ -f "$wall" ] || return 1

    echo "$wall" > "$STATE_FILE"

    case "$setter" in
        swaybg)
            pkill -x swaybg 2>/dev/null
            swaybg -i "$wall" -m fill &
            ;;
        swww)
            swww img "$wall" --transition-type fade ;;
        hyprpaper)
            hyprctl hyprpaper wallpaper ",$wall" ;;
        *)
            notify-send "Wallpaper" "No supported Wayland wallpaper setter found (install swaybg or swww)!" 2>/dev/null
            exit 1
            ;;
    esac

    local name
    name=$(basename "$wall")
    notify-send -i "preferences-desktop-wallpaper" "Wallpaper Changed" "$name" 2>/dev/null || true
}

SETTER=$(detect_setter)

case "${1:-}" in
    --random|-r)
        mapfile -t WALLS < <(find -L "$WALLDIR/" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) 2>/dev/null)
        if [ ${#WALLS[@]} -gt 0 ]; then
            RANDOM_WALL="${WALLS[RANDOM % ${#WALLS[@]}]}"
            set_wallpaper "$RANDOM_WALL" "$SETTER"
        else
            notify-send "Wallpaper" "No images found in $WALLDIR" 2>/dev/null
        fi
        exit 0
        ;;
    "")
        command -v fuzzel >/dev/null 2>&1 || { echo "fuzzel not found"; exit 1; }
        mapfile -t LIST < <(find -L "$WALLDIR/" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) -exec basename {} \; 2>/dev/null)
        if [ ${#LIST[@]} -eq 0 ]; then
            notify-send "Wallpaper" "No images found in $WALLDIR" 2>/dev/null
            exit 0
        fi
        CHOSEN=$(printf '%s\n' "${LIST[@]}" | fuzzel --dmenu --prompt="Wallpaper: " --width=30)
        [ -n "$CHOSEN" ] && set_wallpaper "$WALLDIR/$CHOSEN" "$SETTER"
        ;;
    *)
        if [ -f "$1" ]; then
            set_wallpaper "$1" "$SETTER"
        else
            echo "File not found: $1"
            exit 1
        fi
        ;;
esac
