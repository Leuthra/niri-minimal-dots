#!/bin/bash
# PowerToys Run equivalent for Niri using Fuzzel
# Features: Application Launcher (native & flatpak), Web Search (? or g), Calculator (= or auto-math), Terminal Command (>), System Actions

# Build initial list of quick actions
ACTIONS="🧮 Calculator: type '= 25 * 4'
🔍 Web Search: type '? search query'
⚡ Run Command: type '> alacritty'
🔒 Lock Screen
⏾ Suspend / Sleep
🖼 Change Wallpaper
📋 Clipboard History
⏻ Power Menu"

# Collect all desktop application directories (system, user, and flatpaks)
APP_DIRS=()
for d in \
    "$HOME/.local/share/applications" \
    "$HOME/.local/share/flatpak/exports/share/applications" \
    "/var/lib/flatpak/exports/share/applications" \
    "/usr/local/share/applications" \
    "/usr/share/applications"; do
    [ -d "$d" ] && APP_DIRS+=("$d")
done

APPS=$(find -L "${APP_DIRS[@]}" -name "*.desktop" 2>/dev/null | while read -r file; do
    grep -qi "^NoDisplay=true" "$file" 2>/dev/null && continue
    name=$(grep -m 1 "^Name=" "$file" 2>/dev/null | cut -d= -f2- | tr -d '\r')
    [ -n "$name" ] && echo "$name"
done | sort -u)

CHOICE=$(printf "%s\n%s\n" "$ACTIONS" "$APPS" | fuzzel --dmenu --prompt "Run: " --width 45 --lines 12)

[ -z "$CHOICE" ] && exit 0

# 1. Calculator (= <expr>)
if [[ "$CHOICE" =~ ^=\ *(.*) ]]; then
    EXPR="${BASH_REMATCH[1]}"
    RESULT=$(python3 -c "import math; print($EXPR)" 2>/dev/null || echo "Error")
    echo -n "$RESULT" | wl-copy 2>/dev/null || true
    notify-send -i "accessories-calculator" "Calculator" "$EXPR = $RESULT (Copied)" 2>/dev/null || true
    exit 0
fi

# 2. Web search (? <query> or g <query>)
if [[ "$CHOICE" =~ ^(\?|g|google)\ +(.*) ]]; then
    QUERY="${BASH_REMATCH[2]}"
    ENCODED=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$QUERY")
    firefox "https://www.google.com/search?q=$ENCODED" &
    exit 0
fi

# 3. Shell execution (> <cmd>)
if [[ "$CHOICE" =~ ^\>\ +(.*) ]]; then
    CMD="${BASH_REMATCH[1]}"
    alacritty -e bash -lc "$CMD" &
    exit 0
fi

# 4. Quick Action matches
case "$CHOICE" in
    "🔒 Lock Screen")
        lockscreen
        exit 0
        ;;
    "⏾ Suspend / Sleep")
        systemctl suspend
        exit 0
        ;;
    "🖼 Change Wallpaper")
        "$HOME/.local/bin/set-wallpaper"
        exit 0
        ;;
    "📋 Clipboard History")
        "$HOME/.local/bin/clipboard-history"
        exit 0
        ;;
    "⏻ Power Menu")
        "$HOME/.local/bin/powermenu"
        exit 0
        ;;
    "🧮 Calculator:"*|"🔍 Web Search:"*|"⚡ Run Command:"*)
        exit 0
        ;;
esac

# 5. Desktop Application launch
# First, exact match on Name
DESKTOP_FILE=$(find -L "${APP_DIRS[@]}" -name "*.desktop" 2>/dev/null | while read -r file; do
    name=$(grep -m 1 "^Name=" "$file" 2>/dev/null | cut -d= -f2- | tr -d '\r')
    if [ "$name" = "$CHOICE" ]; then
        echo "$file"
        break
    fi
done | head -n 1)

# Fallback: case-insensitive Name match
if [ -z "$DESKTOP_FILE" ]; then
    DESKTOP_FILE=$(find -L "${APP_DIRS[@]}" -name "*.desktop" 2>/dev/null | while read -r file; do
        name=$(grep -m 1 "^Name=" "$file" 2>/dev/null | cut -d= -f2- | tr -d '\r')
        if [[ "${name,,}" == "${CHOICE,,}" ]]; then
            echo "$file"
            break
        fi
    done | head -n 1)
fi

# Fallback: filename contains choice (e.g. 'obs' -> 'com.obsproject.Studio.desktop')
if [ -z "$DESKTOP_FILE" ]; then
    DESKTOP_FILE=$(find -L "${APP_DIRS[@]}" -iname "*$CHOICE*.desktop" 2>/dev/null | head -n 1)
fi

if [ -n "$DESKTOP_FILE" ]; then
    if command -v gio >/dev/null 2>&1; then
        gio launch "$DESKTOP_FILE" &
        exit 0
    elif command -v gtk-launch >/dev/null 2>&1; then
        app_id="$(basename "$DESKTOP_FILE" .desktop)"
        gtk-launch "$app_id" &
        exit 0
    else
        EXEC_CMD=$(grep -m 1 "^Exec=" "$DESKTOP_FILE" | cut -d= -f2- | sed 's/ %[a-zA-Z]//g')
        eval "$EXEC_CMD" &
        exit 0
    fi
fi

# 6. Direct command execution
if command -v "$CHOICE" >/dev/null 2>&1; then
    "$CHOICE" &
    exit 0
fi

# 7. Flatpak app ID or Name search
if command -v flatpak >/dev/null 2>&1; then
    MATCHING_FLATPAK=$(flatpak list --app --columns=application,name 2>/dev/null | grep -i "$CHOICE" | awk '{print $1}' | head -n 1)
    if [ -n "$MATCHING_FLATPAK" ]; then
        flatpak run "$MATCHING_FLATPAK" &
        exit 0
    fi
fi

# 8. Automatic math fallback (e.g. user typed '15 * 40' without '=')
MATH_RESULT=$(python3 -c "import math; res = $CHOICE; print(res)" 2>/dev/null)
if [ -n "$MATH_RESULT" ]; then
    echo -n "$MATH_RESULT" | wl-copy 2>/dev/null || true
    notify-send -i "accessories-calculator" "Calculator" "$CHOICE = $MATH_RESULT (Copied)" 2>/dev/null || true
    exit 0
fi

# 9. App / Command not found notification
notify-send -i "dialog-error" "Launcher" "Command or app not found: $CHOICE\nTip: Use '? query' to search Google" 2>/dev/null || true
exit 1
